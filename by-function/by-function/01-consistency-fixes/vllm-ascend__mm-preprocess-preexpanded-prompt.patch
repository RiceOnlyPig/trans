+def _split_image_sentinel_blocks(token_ids: Sequence[int]) -> "list[tuple[int, int]]":
+    """Split maximal runs of in-vocab image sentinel ids into per-image blocks.
+
+    Each block is ``[IMAGE_PAD * compress_pad, IMAGE_START, <N-layout
+    interleave>, IMAGE_PAD * pad_last, IMAGE_END]`` (see ``build_image_block``).
+    Blocks often abut without text in between, so runs are split on the block
+    structure (leading pads -> IMAGE_START -> ... -> IMAGE_END), not on run
+    boundaries alone.
+    """
+    lo = IMAGE_SENTINEL_BASE_ID
+    hi = IMAGE_SENTINEL_BASE_ID + len(IMAGE_SENTINEL_TOKEN_NAMES)
+    start_id = IMAGE_SENTINEL_BASE_ID + IMAGE_START
+    pad_id = IMAGE_SENTINEL_BASE_ID + IMAGE_PAD
+    end_id = IMAGE_SENTINEL_BASE_ID + IMAGE_END
+
+    blocks: "list[tuple[int, int]]" = []
+    i, n = 0, len(token_ids)
+    while i < n:
+        if not (lo <= token_ids[i] < hi):
+            i += 1
+            continue
+        block_start = i
+        while i < n and token_ids[i] == pad_id:
+            i += 1
+        if i >= n or token_ids[i] != start_id:
+            i = block_start + 1
+            continue
+        end = i
+        while end < n and token_ids[end] != end_id:
+            end += 1
+        if end >= n:
+            i = block_start + 1
+            continue
+        blocks.append((block_start, end + 1))
+        i = end + 1
+    return blocks
+
 
 
