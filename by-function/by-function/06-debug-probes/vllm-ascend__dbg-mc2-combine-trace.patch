# ============================================================================
# patch : vllm-ascend__dbg-mc2-combine-trace.patch
# 功能  : token_dispatcher.py：DSV4_MOE_TRACE=1 时打印 [MC2COMBINE] ep_send_counts/expert_ids/global_bs
# 仓库  : /vllm-workspace/main/zyy/vllm-ascend
# 应用  : cd /vllm-workspace/main/zyy/vllm-ascend && patch -p1 < vllm-ascend__dbg-mc2-combine-trace.patch
# 对应旧编号: 无
# 备注  : 旧 0005 针对 Megatron-LM 同名探针已随仓库还原不复存在；本 patch 为 vllm-ascend 侧现存探针
# ============================================================================
diff --git a/vllm_ascend/ops/fused_moe/token_dispatcher.py b/vllm_ascend/ops/fused_moe/token_dispatcher.py
index cb9e65787..660104d24 100644
--- a/vllm_ascend/ops/fused_moe/token_dispatcher.py
+++ b/vllm_ascend/ops/fused_moe/token_dispatcher.py
@@ -328,6 +328,19 @@ class TokenDispatcherWithMC2(MoETokenDispatcher[MoEMC2CombineMetadata]):
         assert bias is None, "Bias is not supported in MoEAlltoAllvTokenDispatcher."
 
         kwargs_mc2 = self.get_combine_mc_kwargs(hidden_states, combine_metadata)
+        import os as _os
+        if _os.environ.get("DSV4_MOE_TRACE", "0") == "1":
+            _ep = kwargs_mc2.get("ep_send_counts")
+            _eid = kwargs_mc2.get("expert_ids")
+            print(
+                f"[MC2COMBINE] rank={self.ep_rank_id} "
+                f"expand_x={tuple(hidden_states.shape)} "
+                f"ep_send_sum={int(_ep.sum()) if _ep is not None else None} "
+                f"ep_send={_ep.detach().cpu().tolist() if _ep is not None else None} "
+                f"expert_ids={tuple(_eid.shape) if _eid is not None else None} "
+                f"global_bs={kwargs_mc2.get('global_bs')}",
+                flush=True,
+            )
         combined_output = torch_npu.npu_moe_distribute_combine_v2(**kwargs_mc2)
 
         return combined_output
