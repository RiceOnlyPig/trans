# ============================================================================
# patch : verl__env-config-knobs.patch
# 功能  : 环境配置：ppo_megatron_trainer.yaml 增加 NPU profiler 配置、constants_ppo VLLM_LOGGING_LEVEL WARN→INFO、geo3k 数据集默认路径
# 仓库  : /workspace/verl
# 应用  : cd /workspace/verl && patch -p1 < verl__env-config-knobs.patch
# 对应旧编号: 无
# 备注  : 均为环境/调参相关，非功能性修复，可选
# ============================================================================
diff --git a/verl/trainer/config/ppo_megatron_trainer.yaml b/verl/trainer/config/ppo_megatron_trainer.yaml
index 2ebe9c78..95f5d330 100644
--- a/verl/trainer/config/ppo_megatron_trainer.yaml
+++ b/verl/trainer/config/ppo_megatron_trainer.yaml
@@ -4,3 +4,35 @@ defaults:
   - ppo_trainer
   - override model_engine: megatron
   - _self_
+global_profiler:
+   steps: [1, 2, 5]
+   save_path: /mnt/share/w50065784/outputs/profile
+actor_rollout_ref:
+   actor:
+      profiler:
+         enable: True  # 设置为 True 以采集训练阶段
+         all_ranks: False
+         ranks: [0]  # 全局 Rank 0
+         tool_config:
+            npu:
+               discrete: True
+               contents: [npu, cpu]
+   rollout:
+      profiler:
+         enable: True  # 设置为 True 以采集推理阶段
+         all_ranks: False
+         ranks: [0]  # 全局 GPU rank；会被映射到拥有该 rank 的推理实例（replica）
+         tool_config:
+            npu:
+               discrete: True  # Agent Loop 模式下必须开启离散模式
+
+   # ref follow actor settings
+   ref:
+      profiler:
+         enable: True  # 设置为 True 以采集训练阶段
+         all_ranks: False
+         ranks: [0]  # 全局 Rank 0
+         tool_config:
+            npu:
+               discrete: True
+               contents: [npu, cpu]
