+    # requirement of the schedule, not a tuning choice.
+    if not getattr(config, "deallocate_pipeline_outputs", False):
+        config.deallocate_pipeline_outputs = True
+    config.coc_fused_kernel = bool(getattr(config, "coc_fused_kernel", False))
+    config.coc_row_nocomm = config.coc_fused_kernel
