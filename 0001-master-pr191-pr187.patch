+# Copyright (c) 2026, HUAWEI CORPORATION. All rights reserved.
+#
+# Licensed under the Apache License, Version 2.0.
+"""DeepSeek-V4-Flash mHC switches that only this stack has.
+
+The shared mHC switch names (``--enable-mhc``, ``--hc-mult``, ``--hc-eps``,
+``--hc-sinkhorn-iters``, ``--use-fused-mhc``) are registered by the GLM mHC
+feature; they are the MindSpeed/verl spellings and every mHC model answers to
+the same ones.  This feature adds only what is DSv4's own, so the GLM file stays
+a GLM file.
+
+It deliberately does *not* subclass that feature: ``register_args`` there would
+register the shared options a second time, and argparse refuses a duplicate
+option string.  Registering only the new switch keeps the two features
+independent -- this one can be dropped without touching GLM, and GLM's can
+change its patches without touching DSv4.
+"""
+
+from __future__ import annotations
+
+import argparse
+
+from megatron_adaptor.features_manager.mindspeed_feature import MindSpeedFeature
+
+from mindspeed_bridge.features.adaptor import get_bridge_model_config
+
+
+class DeepSeekV4FlashMHCFeature(MindSpeedFeature):
+    """The DSv4-only mHC switch: the split form of the fused pre step."""
+
+    def __init__(self):
+        super().__init__(feature_name="dsv4_flash_mhc", optimization_level=0)
+
+    def register_args(self, parser: argparse.ArgumentParser):
+        """Expose the DSv4 mHC switch on the unified CLI.
+
+        A VERL launch reaches Bridge through the shell command line, so a knob it
+        may pass has to be registered here.  The default stays neutral: only an
+        option actually present on the command line is translated onto the
+        provider in :meth:`validate_args`.
+        """
+        group = parser.add_argument_group(title=self.feature_name)
+        group.add_argument(
+            "--use-fused-split-mhc-pre",
+            action="store_true",
+            default=False,
+            help="run the fused mHC pre step as separate mhc_pre and mhc_sinkhorn operators; "
+            "requires --use-fused-mhc.",
+        )
+
+    def validate_args(self, args):
+        """Refuse the switch on its own and translate it onto the provider.
+
+        The split switch picks *how* the fused pre step runs and does nothing to
+        the eager chain, so on its own it would silently have no effect; refuse it
+        the way the MindSpeed-LLM side does.  The provider repeats the check for
+        the config-field spelling (``model.use_fused_split_mhc_pre``), which is
+        the path a Bridge recipe takes.
+        """
+        if getattr(args, "use_fused_split_mhc_pre", False) and not getattr(args, "use_fused_mhc", False):
+            raise ValueError("--use-fused-split-mhc-pre requires --use-fused-mhc.")
+        explicit = getattr(args, "_explicit_feature_args", ()) or ()
+        config = get_bridge_model_config(args)
+        if config is None:
+            return
+        if "use_fused_split_mhc_pre" in explicit:
+            config.use_fused_split_mhc_pre = bool(args.use_fused_split_mhc_pre)
+
+
+__all__ = ["DeepSeekV4FlashMHCFeature"]
diff --git a/mindspeed_bridge/features/megatron/deepseek_v4_flash/moe_fb_overlap.py b/mindspeed_bridge/features/megatron/deepseek_v4_flash/moe_fb_overlap.py
