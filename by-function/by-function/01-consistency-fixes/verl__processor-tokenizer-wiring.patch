# ============================================================================
# patch : verl__processor-tokenizer-wiring.patch
# 功能  : DeepseekV4Processor 直接构建（绕过 transformers remote-code 缓存缺陷）、DeepSeekV4VL continuous token builder 注册、trainer_base processor 兜底加载
# 仓库  : /workspace/verl
# 应用  : cd /workspace/verl && patch -p1 < verl__processor-tokenizer-wiring.patch
# 对应旧编号: 无
# 备注  : 无
# ============================================================================
diff --git a/verl/utils/tokenizer/tokenizer.py b/verl/utils/tokenizer/tokenizer.py
index 65f528bb..e02b6042 100644
--- a/verl/utils/tokenizer/tokenizer.py
+++ b/verl/utils/tokenizer/tokenizer.py
@@ -193,7 +193,40 @@ def hf_processor(name_or_path, **kwargs):
     from transformers import AutoConfig, AutoProcessor, PreTrainedTokenizerBase
 
     try:
-        processor = AutoProcessor.from_pretrained(name_or_path, **kwargs)
+        processor = None
+        # Direct-build for deepseek_v4: transformers remote-code caching copies
+        # only the auto_map module out of the model dir, which breaks our
+        # self-contained sibling imports (image_processor.py / encoding_dsv4.py).
+        import importlib.util as _ilu
+        import os as _os
+
+        from transformers import AutoConfig as _AC
+
+        _cfg_try = None
+        try:
+            _cfg_try = _AC.from_pretrained(name_or_path, **kwargs)
+        except Exception:
+            _cfg_try = None
+        if _cfg_try is not None and getattr(_cfg_try, "model_type", None) == "deepseek_v4":
+            _proc_path = _os.path.join(name_or_path, "processing_deepseek_v4.py")
+            if not _os.path.exists(_proc_path):
+                _proc_path = _os.path.join(
+                    _os.path.dirname(_os.path.abspath(name_or_path)),
+                    "DeepSeek-V4-Processor",
+                    "processing_deepseek_v4.py",
+                )
+            if _os.path.exists(_proc_path):
+                _spec = _ilu.spec_from_file_location("dsv4_processor_direct", _proc_path)
+                _mod = _ilu.module_from_spec(_spec)
+                _spec.loader.exec_module(_mod)
+                from transformers import AutoTokenizer as _AT
+
+                processor = _mod.DeepseekV4Processor(
+                    tokenizer=_AT.from_pretrained(name_or_path, **kwargs),
+                    vocab_size=getattr(_cfg_try, "vocab_size", 129280),
+                )
+        if processor is None:
+            processor = AutoProcessor.from_pretrained(name_or_path, **kwargs)
         # In newer transformers, AutoProcessor may legitimately fall back to a
         # tokenizer backend (e.g. TokenizersBackend) for text-only models.
         # Treat it as "no multimodal processor" and let callers use hf_tokenizer.
@@ -228,10 +261,14 @@ def hf_processor(name_or_path, **kwargs):
                 model_class = Glm46VModel
             case "MllamaProcessor":
                 pass  # MllamaProcessor and MllamaModel doesn't have get_rope_index property
+            case "DeepseekV4VLProcessor":
+                pass  # MllamaProcessor and MllamaModel doesn't have get_rope_index property
             case "Gemma4Processor":
                 # Gemma4 uses standard 1D RoPE -> no get_rope_index to bind. Disable its strict
                 # per-image-token check (which Qwen's processor lacks).
                 processor.validate_inputs = lambda *args, **kwargs: None
+            case "DeepseekV4Processor":
+                pass
             case _:
                 raise ValueError(f"Unsupported processor type: {processor.__class__.__name__}")
 
