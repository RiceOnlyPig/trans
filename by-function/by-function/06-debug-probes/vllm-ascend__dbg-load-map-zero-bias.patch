# ============================================================================
# patch : vllm-ascend__dbg-load-map-zero-bias.patch
# 功能  : model.py：_dbg_map 跟踪未加载权重并 [DBG_SKIP] 打印；/tmp/dsv4_zero_bias_vl 触发 gate.bias_vl 清零探针；注释掉的 [dbg] 打印
# 仓库  : /vllm-workspace/main/zyy/vllm-ascend
# 应用  : cd /vllm-workspace/main/zyy/vllm-ascend && patch -p1 < vllm-ascend__dbg-load-map-zero-bias.patch
# 对应旧编号: 无
# 前置依赖: 须先应用 03 组 vllm-ascend__load-params-dict-guards.patch（同文件链）
# 备注  : 无
# ============================================================================
diff --git a/vllm_ascend/models/deepseek_v4/model.py b/vllm_ascend/models/deepseek_v4/model.py
--- a/vllm_ascend/models/deepseek_v4/model.py
+++ b/vllm_ascend/models/deepseek_v4/model.py
@@ -1157,7 +1157,10 @@
         heads_per_rank = self.config.num_attention_heads // tp_size
         head_start = tp_rank * heads_per_rank
 
+        self._dbg_map = {}
         for name, loaded_weight in weights:
+            _dbg_orig = name
+            self._dbg_map[_dbg_orig] = False
             spec_layer = get_spec_layer_idx_from_weight_name(self.config, name)
             if spec_layer is not None:
                 continue  # skip spec decode layers for main model
@@ -1219,6 +1222,7 @@
                     narrow_weight = loaded_weight.narrow(0, head_start, heads_per_rank)
                     param.data.copy_(narrow_weight)
                 loaded_params.add(name)
+                self._dbg_map[_dbg_orig] = True
                 continue
 
             is_fusion_moe_shared_experts_layer = rocm_aiter_moe_shared_expert_enabled and ("mlp.shared_experts" in name)
@@ -1324,6 +1328,11 @@
                         # other available replicas.
                         weight_loader = typing.cast(Callable[..., bool], param.weight_loader)
 
+                        # print(f"[dbg] name={name_mapped} param={tuple(param.shape)} "
+                        #     f"loaded={tuple(weight_to_load.shape)} "
+                        #     f"shard_id={shard_id} expert_id={expert_id} "
+                        #     f"param_dtype={param.dtype} loaded_dtype={weight_to_load.dtype}")
+                        
                         success = weight_loader(
                             param,
                             weight_to_load,
@@ -1337,6 +1346,7 @@
                                 name = name_mapped
                             else:
                                 loaded_params.add(name_mapped)
+                                self._dbg_map[_dbg_orig] = True
                             break
                     else:
                         if is_expert_weight:
@@ -1363,5 +1373,19 @@
                         weight_loader(param, loaded_weight)
             if not is_fusion_moe_shared_experts_layer:
                 loaded_params.add(name)
+                self._dbg_map[_dbg_orig] = True
 
+        import os as _os  # kept for the flag-gated zero-bias probe below
+        if _os.path.exists("/tmp/dsv4_zero_bias_vl"):
+            _n = 0
+            for _pn, _pp in self.named_parameters():
+                if _pn.endswith("gate.bias_vl"):
+                    _pp.data.zero_()
+                    _n += 1
+            print(f"[DBG_ZERO_BIAS_VL] zeroed {_n}", flush=True)
+        if get_tensor_model_parallel_rank() == 0:
+            _skipped = [k for k, v in self._dbg_map.items() if not v]
+            print(f"[DBG_SKIP] total={len(self._dbg_map)} skipped={len(_skipped)}", flush=True)
+            for _s in _skipped:
+                print(f"[DBG_SKIP] {_s}", flush=True)
         return loaded_params
