+++ b/verl/utils/debug/metrics.py
@@ -61,6 +61,25 @@ def calculate_log_prob_diff(log_probs1: torch.Tensor, log_probs2: torch.Tensor,
 
 
 def calculate_debug_metrics(data: DataProto) -> dict:
+    try:
+        import os as _os
+        _out = "/mnt/share/w50065784/kimi-agent/rollout_debug/dbg_step1.pt"
+        if not _os.path.exists(_out):
+            _os.makedirs(_os.path.dirname(_out), exist_ok=True)
+            _d = {}
+            for _k in ("input_ids", "prompts", "responses", "attention_mask", "position_ids",
+                       "response_mask", "rollout_log_probs", "old_log_probs"):
+                if _k in data.batch.keys():
+                    _d[_k] = data.batch[_k].detach().cpu()
+            for _k, _v in data.non_tensor_batch.items():
+                try:
+                    _d["NT:" + _k] = _v
+                except Exception:
+                    pass
+            torch.save(_d, _out)
+            print(f"DEBUG_DUMP_SAVED {_out} keys={list(_d.keys())}")
+    except Exception as _e:
+        print(f"DEBUG_DUMP_FAILED: {_e!r}")
