+    def _xfer_local_expert_ids(self):
+        ids = getattr(self, "_xfer_local_expert_id_set", "__unset__")
+        if ids != "__unset__":
+            return ids
+        ids = None
+        for model in self._iter_all_models():
+            m = model
+            if hasattr(m, "runnable") and "ACLGraphWrapper" in str(type(m)):
+                m = m.runnable
+            for module in m.modules():
+                start = getattr(module, "physical_expert_start", None)
+                n_local = getattr(module, "n_local_physical_experts", None)
+                if start is not None and n_local is not None:
+                    ids = set(range(int(start), int(start) + int(n_local)))
+                    break
+            if ids is not None:
+                break
+        self._xfer_local_expert_id_set = ids
+        return ids
+
+    def _xfer_drop_nonlocal_experts(self, param_updates):
+        """Drop expert weights this engine discards anyway (EP: the vLLM loader
+        skips experts not mapped locally), keeping them out of the per-tensor
+        load path entirely."""
+        ids = self._xfer_local_expert_ids()
+        if ids is None:
+            return param_updates
+        kept, dropped = [], 0
+        for name, tensor in param_updates:
+            mm = _XFER_EXPERT_RE.search(name)
+            if mm is not None and int(mm.group(1)) not in ids:
+                dropped += 1
+                continue
+            kept.append((name, tensor))
+        if dropped:
+            print(f"[XFER_EPFILTER] dropped {dropped} non-local expert tensors, local ids={sorted(ids)}", flush=True)
+        return kept
+
