index 0000000..b350e9e
--- /dev/null
+++ b/mindspeed_bridge/features/megatron/deepseek_v4_flash/moe_fb_overlap.py
@@ -0,0 +1,463 @@
+# Copyright (c) 2026, HUAWEI CORPORATION. All rights reserved.
+#
+# Licensed under the Apache License, Version 2.0.
+"""DeepSeek-V4-Flash integration for MindSpeed's MoE forward/backward overlap.
+
+Scoped to this stack rather than kept as a common feature: what it supplies are
+the things MindSpeed assumes and *this* model does not provide the way it
+expects -- DSv4's hyper connections need their own staging adapter, its clamped
+SwiGLU needs the staged experts' check relaxed, and its hash router has to
+survive their MoE layer.  Another model wanting the overlap would need its own
+answers to the same questions, not these.
+
+MindSpeed owns the schedule: it rebinds ``TransformerBlock.forward`` and every
+layer's ``forward`` to a staged implementation, replaces the MoE spec with its
+grouped experts, and interleaves microbatch *i*'s forward with microbatch
+*i-1*'s backward (at PP=1 through ``forward_backward_no_pipelining``).  This
+module supplies only what MindSpeed assumes but Bridge does not provide:
+
+* ``extra_block_kwargs`` routing.  MindSpeed hands the backward state to the
+  model as a forward kwarg; vanilla MCore ``GPTModel.forward`` has no such
+  parameter, so it is injected into the decoder call instead.
+* wgrad fusion.  MindSpeed defers expert wgrad to ``WeightGradStore`` and reads
+  one global flag to decide whether to use the fused kernel, but Bridge lets
+  each Linear decide; the producing Linear's choice is carried on the weight.
+* embedding gradients, which must not be accumulated out of a zeroed main-grad
+  buffer once DDP's post-hooks are rewired.
+* shared experts, whose MindSpeed implementation reads ``n_shared_experts`` --
+  a MindSpeed-LLM name that Bridge's provider does not define.
+
+Everything here is gated on ``moe_fb_overlap`` and is a no-op otherwise, so the
+feature stays mounted for every model.  Models with their own layer structure
+(hyper connections, for instance) need their own staging adapter on top of
+this; such a model must refuse the flag until that adapter exists.
+"""
+
+from __future__ import annotations
+
+import logging
+import sys
+
+from dataclasses import replace
+from functools import wraps
+from inspect import signature
+from typing import Any
+
+import torch
+
+from mindspeed.features_manager.moe.fb_overlap import (
+    MoEFwdBwdOverlapFeature as MindSpeedMoEFwdBwdOverlapFeature,
+)
+
+from mindspeed_bridge.features.adaptor import get_bridge_model_config
+
+logger = logging.getLogger(__name__)
+
+# Set on a weight by the Linear that produced it, read when its delayed wgrad
+# finally runs inside MindSpeed's WeightGradStore.
+_FB_WGRAD_FUSION_ATTR = "_mindspeed_bridge_fb_gradient_accumulation_fusion"
+
+
+class MoEFwdBwdOverlapFeature(MindSpeedMoEFwdBwdOverlapFeature):
+    """MindSpeed F/B overlap with the Bridge-side compatibility patches."""
+
+    def validate_args(self, args):
+        super().validate_args(args)
+        if not getattr(args, "moe_fb_overlap", False):
+            return
+
+        config = get_bridge_model_config(args)
+        if config is not None:
+            sync_mindspeed_config(config)
+            # MindSpeed's staged forward reads args.enable_mhc to decide whether
+            # to drive the hyper-connection stages; Bridge models name the same
+            # thing on the config, so publish it here.
+            if bool(getattr(config, "enable_mhc_connections", False)):
+                args.enable_mhc = True
+                args.hc_mult = int(getattr(config, "mhc_num_residual_streams", 1) or 1)
+
+    def register_patches(self, patch_manager, args):
+        super().register_patches(patch_manager, args)
+        if not getattr(args, "moe_fb_overlap", False):
+            return
+
+        # Hyper connections: MindSpeed's staged forward drives them through a
+        # two-stage protocol that each model's own layer has to implement, so
+        # the adapter is registered per model.  Registered after the super()
+        # call above, which means it wraps MindSpeed's block __init__ from the
+        # outside and sees the staged forwards it installed.
+        config = get_bridge_model_config(args)
+        if config is not None and bool(getattr(config, "enable_mhc_connections", False)):
+            from mindspeed_bridge.models.deepseek_v4_flash.modelling_deepseek_v4_flash.mhc_fb_overlap import (
+                register_dsv4_mhc_fb_overlap_patch,
+            )
+
+            register_dsv4_mhc_fb_overlap_patch(patch_manager)
+
+        patches = (
+            (
+                "megatron.core.models.gpt.gpt_model.GPTModel.forward",
+                gpt_model_fb_overlap_forward_wrapper,
+            ),
+            (
+                "megatron.core.tensor_parallel.layers.LinearWithGradAccumulationAndAsyncCommunication.backward",
+                cache_linear_gradient_accumulation_fusion_wrapper,
+            ),
+            (
+                "megatron.core.tensor_parallel.layers.VocabParallelEmbedding.__init__",
+                embedding_gradient_accumulation_wrapper,
+            ),
+            (
+                "mindspeed.core.transformer.moe.moe_feature.fb_overlap.modules."
+                "weight_grad_store.WeightGradStore.overlap_matmul",
+                weight_grad_store_overlap_matmul_wrapper,
+            ),
+            (
+                "mindspeed.core.transformer.moe.moe_feature.fb_overlap.modules.shared_experts."
+                "SharedExpertMLPFbOverlap.__init__",
+                shared_expert_mcore_linears_wrapper,
+            ),
+            (
+                "mindspeed.core.transformer.moe.moe_feature.fb_overlap.modules.experts."
+                "MindSpeedFbOverlapGmmExperts._validate_fb_overlap_config",
+                experts_allow_clamped_glu_wrapper,
+            ),
+            (
+                "mindspeed.core.transformer.moe.moe_feature.fb_overlap.modules.moe_layer."
+                "MindSpeedFbOverlapMoELayer.__init__",
+                moe_layer_spec_router_wrapper,
+            ),
+        )
+        for target, wrapper in patches:
+            patch_manager.register_patch(target, wrapper)
+
+
+def moe_layer_spec_router_wrapper(original):
+    """Build the *spec's* router in MindSpeed's F/B-overlap MoE layer.
+
+    Its ``__init__`` hardcodes ``self.router = TopKRouter(...)`` instead of
+    reading ``submodules.router``, which assumes a router whose behaviour the
+    config can reconstruct in full.  That holds for a model whose routing is
+    config-expressed -- a score function, a top-k, an expert bias -- and not for
+    one whose routing lives in a subclass: DSv4's first layers do not score at
+    all, they look the expert ids up in a ``tid2eid`` table, which
+    ``Dsv4HashRouter`` implements by overriding ``routing``.  The table is a
+    buffer on that subclass, so the stock router is also no home for the
+    checkpoint's ``ffn.gate.tid2eid`` weights: left alone, a run that loads real
+    weights would find no destination for the table and would score where the
+    checkpoint says look up -- silently, because scoring is also the legitimate
+    path for a checkpoint that ships no table.
+
+    MindSpeed's own ``replace`` of the submodules keeps the router slot (it swaps
+    only experts and shared_experts), so the spec's class is still there to be
+    used; this reads as a missed line rather than a decision.
+
+    Rather than rebuild the router afterwards -- which would construct one
+    throwaway module and consume an extra round of init RNG, shifting the
+    initialisation of everything after it -- the module-global name their line
+    resolves is rebound to the slot's class for the duration of the call, so
+    *their* construction builds *our* router with exactly their arguments.
+    Model construction is single-threaded and the name is restored in a finally,
+    so nothing else observes the swap.
+
+    A no-op for a spec whose slot is the stock router, which is every other
+    model in the tree.
+    """
+
+    @wraps(original)
+    def init_with_spec_router(self, config, submodules=None, *args, **kwargs):
+        slot = getattr(submodules, "router", None)
+        module = sys.modules.get(original.__module__)
+        stock = getattr(module, "TopKRouter", None) if module is not None else None
+        usable = (
+            slot is not None
+            and stock is not None
+            and slot is not stock
+            and isinstance(slot, type)
+            and issubclass(slot, stock)
+        )
+        if not usable:
+            return original(self, config, submodules, *args, **kwargs)
+        module.TopKRouter = slot
+        try:
+            result = original(self, config, submodules, *args, **kwargs)
+        finally:
+            module.TopKRouter = stock
+        # Said once per process: the only positive evidence in the log that the
+        # overlapped layers kept the model's own router rather than the stock one.
+        if not getattr(init_with_spec_router, "_announced", False):
+            init_with_spec_router._announced = True
+            logger.info(
+                "dsv4 fb overlap: MindSpeed's MoE layer builds the spec's router (%s), not the stock %s",
+                slot.__name__,
+                stock.__name__,
+            )
+        return result
+
+    return init_with_spec_router
+
+
+def experts_allow_clamped_glu_wrapper(original):
+    """Let MindSpeed's staged experts run a clamped GLU that the model supplies.
+
+    They reject ``activation_func_clamp_value`` outright, because neither of
+    their own activation arms applies it -- a correct refusal in general, since
+    the alternative is dropping a clamp the checkpoint declares.  It stops being
+    correct once the model has routed its fused activation through a clamp-aware
+    implementation *in this very module*: the model's SwiGLU patch replaces
+    ``weighted_bias_swiglu_impl`` here, and for DSv4 that replacement is the CANN
+    clipped SwiGLU, so the clamp is represented and the rejection no longer
+    holds.  The marker below is what distinguishes the two cases; without it the
+    rejection stands.
+
+    The config value is hidden only for the duration of their check -- every
+    other rejection in it still runs.
+    """
+
+    @wraps(original)
+    def validate_with_clamped_glu(self, *args, **kwargs):
+        clamp = getattr(self.config, "activation_func_clamp_value", None)
+        if clamp is None or not _clamped_glu_installed(type(self)):
+            return original(self, *args, **kwargs)
+        self.config.activation_func_clamp_value = None
+        try:
+            return original(self, *args, **kwargs)
+        finally:
+            self.config.activation_func_clamp_value = clamp
+
+    return validate_with_clamped_glu
+
+
+def _clamped_glu_installed(experts_class) -> bool:
+    """True when the staged experts' fused activation carries the model's clamp.
+
+    The marker is set by the model's own SwiGLU patch when it replaces
+    ``weighted_bias_swiglu_impl`` in MindSpeed's experts module.  Absent -- a
+    tree whose fused SwiGLU does not reach into this module, or a run with the
+    fusion off -- the staged experts would silently compute an unclamped GLU, so
+    the rejection must stand.
+    """
+    module = sys.modules.get(experts_class.__module__)
+    impl = getattr(module, "weighted_bias_swiglu_impl", None)
+    return bool(getattr(impl, "_bridge_applies_activation_clamp", False))
+
+
+def gpt_model_fb_overlap_forward_wrapper(original):
+    """Route MindSpeed's ``extra_block_kwargs`` through vanilla MCore GPTModel.
+
+    MindSpeed's schedule binds the kwarg onto the outermost model's forward, so
+    it arrives here through the wrappers (DDP, Float16Module and, for a VLM, the
+    multimodal model that forwards ``**kwargs`` to its language model).  MCore
+    v0.18's GPTModel does not accept it, so it is handed to the decoder -- the
+    block whose forward MindSpeed replaced -- for the duration of the call.
+    The layer graphs travel back out through the block itself
+    (``block.get_fwd_layer_graphs()``), not through this return value.
+    """
+    if getattr(original, "_mindspeed_bridge_fb_overlap_extra_kwargs", False):
+        return original
+    original_parameters = signature(original).parameters
+
+    @wraps(original)
+    def forward_with_fb_overlap_kwargs(self, *args, extra_block_kwargs=None, **kwargs):
+        if "extra_block_kwargs" in original_parameters:
+            return original(self, *args, extra_block_kwargs=extra_block_kwargs, **kwargs)
+        if not extra_block_kwargs:
+            return original(self, *args, **kwargs)
+        decoder = self.decoder
+        original_decoder_forward = decoder.forward
+
+        @wraps(original_decoder_forward)
+        def decoder_forward_with_fb_overlap_kwargs(*decoder_args, **decoder_kwargs):
+            decoder_kwargs.update(extra_block_kwargs)
+            return original_decoder_forward(*decoder_args, **decoder_kwargs)
+
+        decoder.forward = decoder_forward_with_fb_overlap_kwargs
+        try:
+            return original(self, *args, **kwargs)
+        finally:
+            decoder.forward = original_decoder_forward
+
+    forward_with_fb_overlap_kwargs._mindspeed_bridge_fb_overlap_extra_kwargs = True
+    forward_with_fb_overlap_kwargs._mindspeed_bridge_original = original
+    return forward_with_fb_overlap_kwargs
+
+
+def cache_linear_gradient_accumulation_fusion_wrapper(original):
+    """Record, on the weight, whether its Linear chose the fused wgrad kernel."""
+
+    @wraps(original)
+    def backward_with_cached_fusion(ctx, grad_output):
+        _, weight = ctx.saved_tensors
+        setattr(weight, _FB_WGRAD_FUSION_ATTR, bool(ctx.gradient_accumulation_fusion))
+        return original(ctx, grad_output)
+
+    return backward_with_cached_fusion
+
+
+def weight_grad_store_overlap_matmul_wrapper(original):
+    """Run the delayed wgrad with the producing Linear's fusion choice.
+
+    MindSpeed's own implementation consults the global
+    ``args.gradient_accumulation_fusion``; under Bridge a Linear may have been
+    built with the fusion off (no ``main_grad`` to accumulate into), and using
+    the fused kernel for it corrupts the gradient.  Grouped (``gmm_weight``)
+    and unmarked weights keep MindSpeed's path.
+    """
+
+    @wraps(original)
+    def overlap_matmul_with_cached_fusion(*call_args):
+        # ``WeightGradStore.overlap_matmul`` is a classmethod, and the patch
+        # manager hands wrappers the *unbound* function before re-applying the
+        # descriptor -- so the call arrives as (cls, cache).  Taking the cache
+        # off the end also covers a MindSpeed build that declares it static.
+        grad_store_cache = call_args[-1]
+        total_input, grad_output, weight, _sequence_parallel, _in_row = grad_store_cache
+        if hasattr(weight, "gmm_weight") or not hasattr(weight, _FB_WGRAD_FUSION_ATTR):
+            return original(*call_args)
+        if len(grad_output.shape) > 2:
+            grad_output = grad_output.contiguous()
+            sb = grad_output.shape[0] * grad_output.shape[1]
+            grad_output = grad_output.view(sb, grad_output.shape[2])
+            total_input = total_input.view(sb, total_input.shape[2])
+        if getattr(weight, _FB_WGRAD_FUSION_ATTR):
+            import fused_weight_gradient_mlp_cuda
+
+            if weight.main_grad.dtype == torch.float32:
+                fused_weight_gradient_mlp_cuda.wgrad_gemm_accum_fp32(total_input, grad_output, weight.main_grad)
+            elif weight.main_grad.dtype in (torch.float16, torch.bfloat16):
+                fused_weight_gradient_mlp_cuda.wgrad_gemm_accum_fp16(total_input, grad_output, weight.main_grad)
+            else:
+                raise RuntimeError("Unsupported gradient type for gradient accumulation fusion")
+        else:
+            grad_weight = grad_output.t().matmul(total_input)
+            weight.main_grad.data.add_(grad_weight)
+        total_input.untyped_storage().resize_(0)
+        grad_output.untyped_storage().resize_(0)
+        return None
+
+    return overlap_matmul_with_cached_fusion
+
+
+def embedding_gradient_accumulation_wrapper(original):
+    """Accumulate embedding gradients without reading a zeroed main-grad buffer.
+
+    F/B overlap rewires DDP's backward post-hooks, which is where the embedding
+    weight's ``main_grad`` would normally be filled; add the gradient here so
+    the first microbatch does not reduce a buffer of zeros.
+    """
+
+    @wraps(original)
+    def init_with_gradient_accumulation(self, *args, **kwargs):
+        original(self, *args, **kwargs)
+        config = kwargs.get("config")
+        if config is None or not getattr(config, "gradient_accumulation_fusion", False):
+            return
+        weight = self.weight
+
+        def accumulate_embedding_grad(grad):
+            if not hasattr(weight, "main_grad") or not hasattr(weight, "grad_added_to_main_grad"):
+                return grad
+            if getattr(weight, "zero_out_wgrad", False):
+                return grad
+            if weight.grad_added_to_main_grad:
+                weight.main_grad.add_(grad)
+            else:
+                weight.main_grad.copy_(grad)
+                weight.grad_added_to_main_grad = True
+            return grad
+
+        weight.register_hook(accumulate_embedding_grad)
+
+    return init_with_gradient_accumulation
+
+
+def shared_expert_mcore_linears_wrapper(original):
+    """Build MindSpeed's F/B-overlap shared expert on MCore linears.
+
+    Its thin staged forward calls ``linear_fc1`` / ``linear_fc2`` directly and
+    does not drive a Transformer Engine module's own backward bookkeeping.
+    """
+
+    @wraps(original)
+    def wrapper(self, config, submodules, gate, *args, **kwargs):
+        from megatron.core.tensor_parallel.layers import ColumnParallelLinear, RowParallelLinear
+
+        submodules = replace(submodules, linear_fc1=ColumnParallelLinear, linear_fc2=RowParallelLinear)
+        return original(self, config, submodules, gate, *args, **kwargs)
+
+    return wrapper
+
+
+def sync_shared_expert_config(config: Any) -> None:
+    """Publish MindSpeed-LLM's shared-expert names from the Bridge provider.
+
+    MindSpeed's shared expert reads ``n_shared_experts``; Bridge configures the
