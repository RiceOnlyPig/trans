+def install_expert_load_logging() -> bool:
+    """``DSV4_LOG_EXPERT_LOAD=1``: log the per-expert token counts of each routing.
+
+    A development probe, off unless the environment variable is set, because it
+    reads the counts back to the host (one more D2H sync per MoE layer) and
+    prints a line per layer.  It patches ``TopKRouter.forward`` rather than this
+    module's subclass on purpose: MindSpeed's F/B-overlap MoE layer constructs a
+    plain ``TopKRouter`` of its own instead of the spec's router slot, so the
+    subclass is not what runs in that configuration -- patching the base class
+    covers both.
+
+    It answers the one question a config dump cannot: whether the routing is
+    actually balanced.  ``moe_router_force_load_balancing`` replaces the logits
+    with random ones, which is balanced *in expectation* -- the counts show how
+    much multinomial spread is left per microbatch.
+    """
+    if os.environ.get("DSV4_LOG_EXPERT_LOAD", "") != "1":
+        return False
+    if getattr(TopKRouter.forward, "_dsv4_logs_expert_load", False):
+        return True
+
+    original = TopKRouter.forward
+
+    def forward_with_load_log(self, *args, **kwargs):
+        probs, routing_map = original(self, *args, **kwargs)
+        try:
+            # routing_map is [tokens, experts] (bool): per-expert token counts.
+            counts = routing_map.sum(dim=0).to(torch.float32)
+            total = counts.sum()
+            n = counts.numel()
+            mx, mn = counts.max().item(), counts.min().item()
+            mean = (total / n).item() if n else 0.0
+            std = counts.std(unbiased=False).item() if n > 1 else 0.0
+            logger.info(
+                "dsv4 expert load: layer=%s experts=%d tokens=%d  min=%.0f mean=%.1f max=%.0f "
+                "std=%.1f  max/mean=%.3f",
+                getattr(self, "layer_number", "?"),
+                n,
+                int(total.item()),
+                mn,
+                mean,
+                mx,
+                std,
+                (mx / mean) if mean else 0.0,
+            )
+        except Exception:  # pylint: disable=broad-except  # a probe must never break a run
+            logger.warning("dsv4 expert load: probe failed", exc_info=True)
+        return probs, routing_map
+
+    forward_with_load_log._dsv4_logs_expert_load = True
+    TopKRouter.forward = forward_with_load_log
+    return True
+
+
+__all__ = ["Dsv4HashRouter", "install_expert_load_logging", "stash_input_ids"]
