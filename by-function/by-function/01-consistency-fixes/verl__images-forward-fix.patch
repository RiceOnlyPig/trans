# 仓库  : /workspace/verl
# 应用  : cd /workspace/verl && patch -p1 < verl__images-forward-fix.patch
# 对应旧编号: 0002
# 备注  : 无
# ============================================================================
diff --git a/verl/models/mcore/model_forward.py b/verl/models/mcore/model_forward.py
